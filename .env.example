# Contact form email delivery (https://resend.com — free tier is enough).
# Without this key the form shows a "not configured" message and falls back to
# the direct email link, so the site still works before you set it up.
RESEND_API_KEY=

# Verified sender. Use "onboarding@resend.dev" until your own domain is verified.
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# Where enquiries are delivered. Defaults to contact.email in src/config/contact.ts.
CONTACT_TO_EMAIL=antonilopezdev@gmail.com
